# ─────────────────────────────────────────────────────────────────────────────
# EduCBT environment configuration
#
# Copy to .env.local for development. Never commit .env.local.
#
# Legend used below:
#   [dev]     needed for local development
#   [prod]    needed for production deployment — the app FAILS CLOSED without it
#   [server]  server-only: must NEVER be exposed to the client bundle
#             (there are intentionally no NEXT_PUBLIC_ variables in this app)
#
# The full variable matrix is in README → "Environment configuration".
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ────────────────────────────────────────────────────────────────
# Exactly three connections exist. Mixing them is the one configuration mistake
# that silently defeats Row-Level Security — owners and superusers bypass every
# RLS policy, so a runtime on the wrong credential looks fine while every tenant
# policy does nothing. The contract is enforced in src/db/connection.ts and
# regression-tested by `npm run test:config`.

# RUNTIME — what the application runs on. [prod: REQUIRED, fails closed]
# Pooled endpoint (-pooler host) of the least-privileged `educbt_app` role.
# In production DATABASE_URL_APP is the ONLY accepted runtime credential.
DATABASE_URL_APP="postgresql://educbt_app:app-role-password@ep-xxx-pooler.region.aws.neon.tech/educbt?sslmode=require"

# RUNTIME FALLBACK — development convenience only. [dev] [server]
# Used only when NODE_ENV is not 'production' and DATABASE_URL_APP is unset,
# so a fresh clone works before the app role is provisioned. Prefer setting
# DATABASE_URL_APP even locally. NEVER used in production.
DATABASE_URL="postgresql://postgres:password@ep-xxx-pooler.region.aws.neon.tech/educbt?sslmode=require"

# MIGRATIONS / DDL — owner or admin credential. [dev + prod migrations]
# [server] Scripts and tooling only (drizzle-kit, db:migrate, db:seed,
# db:provision-app-role, test fixtures). Application code never reads it —
# enforced by `npm run test:config`. UNPOOLED: PgBouncer transaction mode
# cannot run the session-level statements DDL requires.
DATABASE_URL_UNPOOLED="postgresql://postgres:owner-password@ep-xxx.region.aws.neon.tech/educbt?sslmode=require"


# ── Auth ────────────────────────────────────────────────────────────────────
# No signing key is needed: sessions are 256-bit random tokens stored as
# SHA-256 hashes (see src/lib/auth/session-store.ts). Cookie security is
# runtime-configured (secure/sameSite in production, http in dev).


# ── Platform ────────────────────────────────────────────────────────────────
# Root domain. Schools resolve as <subdomain>.PLATFORM_DOMAIN, and hostnames
# are lookup keys only — never proof of access. [dev + prod]
PLATFORM_DOMAIN="educbt.com"


# ── Rate limiting (login throttle) ───────────────────────────────────────────
# Upstash Redis REST credentials. Optional: when unset the limiter fails open
# and only the database-level account lockout remains (by design — a rate
# limiter must not be the reason a school cannot start an exam).
# [dev: optional] [prod: strongly recommended] [server]
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ── Database backups (nightly pg_dump → Cloudflare R2) ───────────────────────
# See README → "Backups and disaster recovery" for the full contract.
#
# BACKUP_DATABASE_URL  [prod: REQUIRED secret] [server]
# Privileged (owner/admin) credential used by the nightly pg_dump. Must NOT
# be the RLS-restricted educbt_app role — a dump over the app role would be
# partially filtered by RLS. Locally it falls back to DATABASE_URL_UNPOOLED.
# BACKUP_DATABASE_URL="postgresql://postgres:owner-password@ep-xxx.region.aws.neon.tech/educbt?sslmode=require"
#
# R2 storage — all four keys are all-or-none: partial configuration is a
# hard error, never a silent fallback to local storage. [prod: REQUIRED]
# R2_BACKUP_ACCESS_KEY_ID=""
# R2_BACKUP_SECRET_ACCESS_KEY=""
# R2_BACKUP_BUCKET="educbt-backups"
# R2_BACKUP_ACCOUNT_ID=""            # endpoint is derived: https://<id>.r2.cloudflarestorage.com
# R2_BACKUP_ENDPOINT=""             # explicit override (also set for MinIO rehearsal)
# R2_BACKUP_REGION="auto"
# R2_BACKUP_FORCE_PATH_STYLE="0"    # 1 only for MinIO/localhost rehearsal
#
# Retention is age-based: backups strictly older than N days are deleted
# after each successful run. Unrelated objects are never touched.
# BACKUP_RETENTION_DAYS="30"
#
# Local directory fallback store — dev/rehearsal only, no cloud account.
# BACKUP_LOCAL_DIR=""
#
# Restore tooling (scripts/restore-database.ts) — REQUIRED, no default:
# the restore target is always a SEPARATE database; the live app database is
# refused outright, and non-local targets need --disaster-recovery.
# RESTORE_DATABASE_URL="postgresql://postgres:pw@localhost:5433/educbt_restore_rehearsal"


# ─────────────────────────────────────────────────────────────────────────────
# BELOW: APPROVED-STACK PLACEHOLDERS — NOT YET REQUIRED. (R2 backup storage is integrated — see above.)
# These services are not integrated yet. Do not set them until the matching
# README section says the feature exists; setting them now does nothing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (Resend) — NOT YET INTEGRATED ─────────────────────────────────────
# Will be used only through the notification service abstraction.
# RESEND_API_KEY=""

# ── SMS (Termii or Africa's Talking) — NOT YET INTEGRATED ────────────────────
# Will be used only through an SMS service abstraction with per-school spend
# controls.
# TERMII_API_KEY=""
# AFRICASTALKING_API_KEY=""

# ── Sentry (error reporting) — NOT YET INTEGRATED ────────────────────────────
# PII-scrubbed server-side capture only.
# SENTRY_DSN=""

# ── Inngest (background jobs) ───────────────────────────────────────────────
# PRODUCTION REQUIRED — SERVER-ONLY SECRET. Signs every request the provider
# makes to /api/inngest (HMAC over the body). Copy from the Inngest dashboard
# (Environment → Keys). NEVER expose client-side; the route refuses to serve
# production invokes without it (503).
INNGEST_SIGNING_KEY=""

# DEVELOPMENT ONLY. Any non-empty value switches the SDK to the local dev
# server (npx inngest-cli dev → http://127.0.0.1:8288) where no credentials
# are needed. Leave unset in production.
# INNGEST_DEV="1"

# Not needed yet — the app currently only RECEIVES scheduled work and sends no
# outbound events. INNGEST_EVENT_KEY becomes required only when a workflow
# starts sending events to Inngest Cloud.
# INNGEST_EVENT_KEY=""
