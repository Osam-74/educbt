# ── Database ────────────────────────────────────────────────────────────────
# POOLED: used by the app. PgBouncer, transaction mode.
# At 0.25 CU, direct max_connections is ~104 — a burst of exam starts saturates
# it. Always use the -pooler host in application code.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-west-1.aws.neon.tech/educbt?sslmode=require"

# UNPOOLED: migrations and DDL only. PgBouncer transaction mode cannot run
# statements that require a session, which DDL does.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-west-1.aws.neon.tech/educbt?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ── Platform ────────────────────────────────────────────────────────────────
# Root domain. Schools resolve as <subdomain>.PLATFORM_DOMAIN
PLATFORM_DOMAIN="educbt.com"

# ── Rate limiting (login throttle) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
